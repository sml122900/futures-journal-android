<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FF121212"
    android:fitsSystemWindows="true">

    <!-- 타이틀바 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:background="#FF1E1E1E">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="오버레이 설정"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- 카운트다운 시간 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="카운트다운 시간 (초, 최소 5)"
                android:textColor="#FF999999"
                android:textSize="13sp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="28dp">

                <EditText
                    android:id="@+id/input_countdown"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:inputType="number"
                    android:textColor="#FFFFFFFF"
                    android:textSize="18sp"
                    android:backgroundTint="#FF444444"
                    android:padding="12dp"
                    android:layout_marginEnd="12dp" />

                <Button
                    android:id="@+id/btn_save_countdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="저장"
                    android:backgroundTint="@color/warning_red" />

            </LinearLayout>

            <!-- 구분선 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#FF2A2A2A"
                android:layout_marginBottom="28dp" />

            <!-- 현재 선택된 멘트 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="현재 선택된 멘트"
                android:textColor="#FF999999"
                android:textSize="13sp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/tv_selected_sentence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:padding="16dp"
                android:background="#FF2A2A2A"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btn_open_sentence_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="멘트 목록"
                android:backgroundTint="#FF2C2C2C"
                android:textColor="#FFFFFFFF" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
