<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 카운트다운 시간 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="카운트다운 시간 (초, 최소 5)"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="32dp">

            <EditText
                android:id="@+id/input_countdown"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="number"
                android:textColor="#FFFFFFFF"
                android:backgroundTint="#FF444444"
                android:padding="12dp"
                android:layout_marginEnd="12dp" />

            <Button
                android:id="@+id/btn_save_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="저장"
                android:backgroundTint="@color/warning_red" />

        </LinearLayout>

        <!-- 타이핑 멘트 선택 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="타이핑 멘트 선택"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/sentence_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="32dp" />

        <!-- 커스텀 멘트 추가 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="커스텀 멘트 추가"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/input_custom_sentence"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="새 멘트 입력"
                android:inputType="text"
                android:textColor="#FFFFFFFF"
                android:textColorHint="#FF757575"
                android:backgroundTint="#FF444444"
                android:padding="12dp"
                android:layout_marginEnd="12dp" />

            <Button
                android:id="@+id/btn_add_sentence"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="추가"
                android:backgroundTint="@color/warning_red" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
